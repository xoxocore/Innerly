# Copy to .env.local for local development. The real values also have to be set
# in Vercel (Project → Settings → Environment Variables) — a .env file in the
# repo is not read by the deployment.

# Supabase project URL and browser key. NEXT_PUBLIC_ means these are baked into
# the client bundle and visible to anyone; that is expected. The publishable
# key is safe there ONLY because row-level security is on for every table —
# see supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only, never NEXT_PUBLIC_. Bypasses every policy, so it must never
# reach the browser or a chat window. Set this directly in Vercel.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
